# Copia este archivo como ".env" y escribe tus claves a la derecha de cada "=".
# El archivo .env no se sube al repositorio. No pegues estas claves en el chat.

# --- Alpaca: SOLO claves de simulación (paper trading) ---
# El bot solo habla con la dirección de simulación de Alpaca.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- FRED: clave gratuita (fred.stlouisfed.org > My Account > API Keys) ---
FRED_API_KEY=

# --- API de Claude: clave de la organización de la Console vinculada a tu plan ---
# Es la que gasta el crédito mensual de API.
ANTHROPIC_API_KEY=

# --- Identificación ante la SEC (la exige para leer sus datos) ---
# Formato: Nombre Apellido correo@ejemplo.com
SEC_USER_AGENT=
